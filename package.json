{
  "name": "linkat",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "_eslint": "eslint --cache --cache-location ./node_modules/.cache/eslint",
    "all": "run-s typecheck format test",
    "build": "run-p -s build:*",
    "build:remix": "react-router build",
    "build:server": "node ./scripts/build-server.js",
    "dev": "NODE_OPTIONS='--import ./instrument.server.mjs' ./scripts/dev.sh | pino-pretty",
    "e2e:large": "playwright test --config playwright/large.config.ts",
    "e2e:medium": "playwright test --config playwright/medium.config.ts",
    "format": "pnpm _eslint --fix && prettier . --write",
    "postinstall": "./scripts/postinstall.sh",
    "lint": "pnpm _eslint && prettier . --check",
    "prepare": "husky",
    "setup-dev": "./scripts/setup-dev.sh",
    "start": "NODE_ENV=production NODE_OPTIONS='--import ./instrument.server.mjs' node ./dist/server.js",
    "start:local": "NODE_ENV=development E2E=1 DISABLE_JETSTREAM=true node --env-file .env ./dist/server.js",
    "test": "vitest run",
    "typecheck": "react-router typegen && tsc",
    "update-lexicons": "lex install --update"
  },
  "dependencies": {
    "@atpassport/client": "0.2.3",
    "@atproto/did": "0.5.5",
    "@atproto/identity": "0.5.13",
    "@atproto/jwk-jose": "0.2.4",
    "@atproto/lex": "0.3.11",
    "@atproto/oauth-client-node": "0.5.7",
    "@atproto/syntax": "0.7.6",
    "@conform-to/react": "1.21.1",
    "@conform-to/zod": "1.21.1",
    "@emoji-mart/data": "1.2.1",
    "@emoji-mart/react": "1.1.1",
    "@gyaku/di": "^4.0.0",
    "@heroicons/react": "2.2.0",
    "@react-router/express": "8.4.0",
    "@react-router/fs-routes": "8.4.0",
    "@react-router/node": "8.4.0",
    "@resvg/resvg-js": "2.6.2",
    "@sentry/react-router": "10.75.0",
    "@skyware/jetstream": "0.2.5",
    "@t3-oss/env-core": "0.13.11",
    "clsx": "2.1.1",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "emoji-mart": "5.6.0",
    "emoji-regex": "11.0.0",
    "express": "5.2.1",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "isbot": "5.2.2",
    "lru-cache": "11.5.2",
    "markdown-it": "15.0.2",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-github-btn": "1.4.0",
    "react-i18next": "17.0.14",
    "react-movable": "3.4.1",
    "react-router": "8.4.0",
    "remix-i18next": "8.0.0",
    "remix-toast": "^4.0.0",
    "remix-utils": "10.0.0",
    "satori": "0.33.4",
    "tailwind-merge": "3.7.0",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@mkizka/eslint-config": "10.0.0",
    "@mkizka/eslint-plugin-aaa": "1.0.2",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/typography": "0.5.20",
    "@testcontainers/postgresql": "12.1.0",
    "@types/express": "5.0.6",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/umami": "2.10.1",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "5.0.1",
    "autoprefixer": "10.6.1",
    "daisyui": "4.12.24",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "msw": "2.15.0",
    "npm-run-all2": "9.0.3",
    "pg": "8.23.0",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "prettier-plugin-pkg": "0.22.1",
    "railway": "3.11.0",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vitest-mock-extended": "5.1.1"
  },
  "sideEffects": false,
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": "eslint --cache --cache-location ./node_modules/.cache/eslint --fix",
    "*": "prettier --ignore-unknown --write"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-pkg"
    ]
  }
}
