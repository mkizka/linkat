{
  "name": "linkat",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.13.0",
  "scripts": {
    "_eslint": "eslint --cache --cache-location ./node_modules/.cache/eslint",
    "all": "run-s typecheck format test",
    "build": "run-p -s build:*",
    "build:remix": "react-router build",
    "build:server": "node ./scripts/build-server.js",
    "dev": "node --import tsx ./dev-env/server.ts pnpm dev:server",
    "dev:server": "NODE_OPTIONS='--import ./instrument.server.mjs' NODE_ENV=development tsx watch --ignore 'vite.config.ts.*' --env-file .env ./app/server.ts | pino-pretty",
    "format": "pnpm _eslint --fix && prettier . --write",
    "postinstall": "./scripts/postinstall.sh",
    "lint": "pnpm _eslint && prettier . --check",
    "prepare": "husky",
    "start:local": "NODE_ENV=development PLAYWRIGHT=1 node --env-file .env ./dist/server.js",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test:large": "playwright test --config playwright/configs/large.config.ts",
    "test:medium": "playwright test --config playwright/configs/medium.config.ts",
    "typecheck": "react-router typegen && tsc",
    "update-lexicons": "lex install --update"
  },
  "dependencies": {
    "@atpassport/client": "0.2.3",
    "@atproto-labs/handle-resolver-node": "0.2.11",
    "@atproto-labs/identity-resolver": "0.4.10",
    "@atproto/did": "0.5.6",
    "@atproto/jwk-jose": "0.2.4",
    "@atproto/lex": "0.3.14",
    "@atproto/oauth-client-node": "0.5.9",
    "@atproto/syntax": "0.7.6",
    "@conform-to/react": "1.21.2",
    "@conform-to/zod": "1.21.2",
    "@emoji-mart/data": "1.2.1",
    "@emoji-mart/react": "1.1.1",
    "@gyaku/di": "5.0.0",
    "@heroicons/react": "2.2.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.81.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@react-router/express": "8.4.0",
    "@react-router/fs-routes": "8.4.0",
    "@react-router/node": "8.4.0",
    "@resvg/resvg-js": "2.6.2",
    "@sentry/react-router": "11.7.0",
    "@skyware/jetstream": "0.2.5",
    "@t3-oss/env-core": "0.13.11",
    "clsx": "2.1.1",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "emoji-mart": "5.6.0",
    "emoji-regex": "11.0.0",
    "express": "5.3.0",
    "i18next": "26.4.4",
    "i18next-browser-languagedetector": "8.2.1",
    "isbot": "5.2.2",
    "lru-cache": "11.5.3",
    "markdown-it": "15.0.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-github-btn": "1.4.0",
    "react-i18next": "17.0.16",
    "react-movable": "3.4.1",
    "react-router": "8.4.0",
    "remix-i18next": "8.0.0",
    "remix-toast": "4.0.0",
    "remix-utils": "10.0.0",
    "satori": "0.56.0",
    "tailwind-merge": "3.7.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@atproto/dev-env": "0.6.18",
    "@mkizka/eslint-config": "10.0.0",
    "@mkizka/eslint-plugin-aaa": "1.0.2",
    "@playwright/test": "1.64.0",
    "@react-router/dev": "8.4.0",
    "@sentry/bundler-plugins": "11.7.0",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/umami": "2.10.1",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.0.4",
    "daisyui": "5.7.40",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "msw": "3.0.3",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.10",
    "prettier-plugin-pkg": "0.22.1",
    "railway": "3.15.0",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vitest-mock-extended": "5.1.1"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": "eslint --cache --cache-location ./node_modules/.cache/eslint --fix",
    "*": "prettier --ignore-unknown --write"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-pkg"
    ]
  }
}
